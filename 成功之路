<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>整合行銷管理師認證｜第一篇 行銷管理概論 (1-55題)</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', '"Noto Sans TC"', 'sans-serif'],
          },
          colors: {
            brand: {
              magenta: '#E542F5',   // 亮紫紅 / 洋紅
              coral: '#FA4332',     // 珊瑚亮紅
              berry: '#F74576',     // 莓果粉紅
              electric: '#A73EF2',  // 電光紫
              orange: '#F74811',    // 活力亮橘
              bg: '#FDF8FF',        // 極淺紫粉白底色
              ink: '#1E1B2E',       // 高對比深色文字
            }
          }
        }
      }
    };
  </script>
</head>
<body class="bg-brand-bg text-brand-ink font-sans antialiased min-h-screen flex flex-col selection:bg-brand-magenta selection:text-white">

  <!-- 頂部導航列 Header -->
  <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-purple-100 shadow-sm">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between py-3 gap-3">
        <!-- 品牌標題區 -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3 cursor-pointer" onclick="switchTab('dashboard')">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-magenta via-brand-electric to-brand-berry flex items-center justify-center text-white font-black text-lg shadow-md shadow-purple-200">
              4P
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h1 class="text-base sm:text-lg font-extrabold tracking-tight text-brand-ink">整合行銷管理師認證</h1>
                <span class="hidden sm:inline-block px-2 py-0.5 text-xs font-bold rounded-full bg-brand-magenta/15 text-brand-electric">1-55題</span>
              </div>
              <p class="text-xs text-slate-500 font-medium">第一篇｜行銷管理概論 互動題庫</p>
            </div>
          </div>

          <!-- 手機版錯題數快速徽章 -->
          <button onclick="switchTab('mistakes')" class="md:hidden flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-brand-coral/10 text-brand-coral text-xs font-bold border border-brand-coral/20">
            <span>錯題本</span>
            <span id="mobile-mistake-badge" class="px-1.5 py-0.2 bg-brand-coral text-white rounded-full text-[11px]">0</span>
          </button>
        </div>

        <!-- 導航分頁按鈕 (支援手機橫向滑動) -->
        <nav class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0 no-scrollbar" aria-label="主導航">
          <button data-tab="dashboard" onclick="switchTab('dashboard')" class="nav-btn whitespace-nowrap px-3.5 py-2 rounded-xl text-sm font-bold transition-all">
            📊 總覽與統計
          </button>
          <button data-tab="practice" onclick="switchTab('practice')" class="nav-btn whitespace-nowrap px-3.5 py-2 rounded-xl text-sm font-bold transition-all">
            ✏️ 刷題練習
          </button>
          <button data-tab="exam" onclick="switchTab('exam')" class="nav-btn whitespace-nowrap px-3.5 py-2 rounded-xl text-sm font-bold transition-all">
            ⏱️ 模擬測驗
          </button>
          <button data-tab="mistakes" onclick="switchTab('mistakes')" class="nav-btn whitespace-nowrap px-3.5 py-2 rounded-xl text-sm font-bold transition-all flex items-center gap-1.5">
            <span>📌 錯題本</span>
            <span id="nav-mistake-badge" class="px-1.5 py-0.5 text-xs rounded-full bg-brand-coral text-white font-extrabold">0</span>
          </button>
          <button data-tab="bank" onclick="switchTab('bank')" class="nav-btn whitespace-nowrap px-3.5 py-2 rounded-xl text-sm font-bold transition-all">
            📚 全題庫
          </button>
        </nav>
      </div>
    </div>
  </header>

  <!-- 全域輕量提示框 (取代 alert) -->
  <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- 自訂確認對話框 Modal (取代 confirm) -->
  <div id="confirm-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-brand-ink/50 backdrop-blur-xs p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-purple-100 transform transition-all">
      <div class="flex items-center gap-3 mb-3">
        <div id="modal-icon" class="w-10 h-10 rounded-full bg-brand-coral/15 text-brand-coral flex items-center justify-center text-xl font-bold">!</div>
        <h3 id="modal-title" class="text-lg font-extrabold text-brand-ink">確認操作</h3>
      </div>
      <p id="modal-desc" class="text-sm text-slate-600 leading-relaxed mb-6">確定要執行此動作嗎？</p>
      <div class="flex justify-end gap-3">
        <button id="modal-cancel-btn" class="px-4 py-2.5 rounded-xl text-sm font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 transition">取消</button>
        <button id="modal-confirm-btn" class="px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-brand-coral hover:opacity-90 shadow-md transition">確定執行</button>
      </div>
    </div>
  </div>

  <!-- 主內容容器 -->
  <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8">

    <!-- ==================== 1. 首頁儀表板與成績統計 ==================== -->
    <section id="view-dashboard" class="space-y-6">
      <!-- 頂部歡迎橫幅 -->
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-brand-electric via-brand-magenta to-brand-berry p-6 sm:p-8 text-white shadow-xl shadow-purple-200/60">
        <div class="relative z-10 max-w-2xl">
          <span class="inline-block px-3 py-1 rounded-full bg-white/20 backdrop-blur-xs text-xs font-bold tracking-wider mb-3">
            MATRIX 矩陣管理顧問參考題庫
          </span>
          <h2 class="text-2xl sm:text-3xl font-black tracking-tight mb-2">準備好拿下整合行銷管理師認證了嗎？</h2>
          <p class="text-sm sm:text-base text-white/90 leading-relaxed mb-6">
            完整收錄第一篇《行銷管理概論》第 1 至 55 題精華題庫，提供即時解析、擬真計時測驗與智慧錯題追蹤，助你一次高分過關！
          </p>
          <div class="flex flex-wrap gap-3">
            <button onclick="startPracticeMode('sequential')" class="px-5 py-3 rounded-xl bg-white text-brand-electric font-extrabold text-sm shadow-md hover:scale-[1.02] active:scale-95 transition">
              🚀 依序開始刷題 (1-55)
            </button>
            <button onclick="startPracticeMode('random')" class="px-5 py-3 rounded-xl bg-brand-ink/25 hover:bg-brand-ink/35 text-white border border-white/30 font-bold text-sm backdrop-blur-xs transition">
              🎲 隨機抽題挑戰
            </button>
            <button onclick="switchTab('exam')" class="px-5 py-3 rounded-xl bg-brand-orange text-white font-extrabold text-sm shadow-md hover:opacity-95 transition">
              ⏱️ 進入模擬測驗
            </button>
          </div>
        </div>
        <!-- 裝飾幾何圓形 -->
        <div class="hidden lg:block absolute -right-10 -bottom-16 w-64 h-64 rounded-full bg-white/10 blur-xl"></div>
        <div class="hidden lg:block absolute right-24 -top-12 w-40 h-40 rounded-full bg-brand-orange/30 blur-lg"></div>
      </div>

      <!-- 四大關鍵數據卡片 -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-5 border border-purple-100 shadow-xs">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-slate-500">累計作答題數</span>
            <span class="w-8 h-8 rounded-lg bg-brand-electric/10 text-brand-electric flex items-center justify-center font-bold">📝</span>
          </div>
          <div class="text-2xl sm:text-3xl font-black text-brand-ink" id="stat-total-answered">0</div>
          <p class="text-xs text-slate-400 mt-1">已覆蓋 <span id="stat-unique-covered" class="font-bold text-brand-electric">0</span> / 55 題</p>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-purple-100 shadow-xs">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-slate-500">總體正確率</span>
            <span class="w-8 h-8 rounded-lg bg-brand-magenta/10 text-brand-magenta flex items-center justify-center font-bold">🎯</span>
          </div>
          <div class="text-2xl sm:text-3xl font-black text-brand-ink"><span id="stat-accuracy">0</span>%</div>
          <p class="text-xs text-slate-400 mt-1">答對 <span id="stat-total-correct" class="font-bold text-emerald-600">0</span> 題</p>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-purple-100 shadow-xs cursor-pointer hover:border-brand-coral/40 transition" onclick="switchTab('mistakes')">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-slate-500">待複習錯題</span>
            <span class="w-8 h-8 rounded-lg bg-brand-coral/10 text-brand-coral flex items-center justify-center font-bold">🔥</span>
          </div>
          <div class="text-2xl sm:text-3xl font-black text-brand-coral" id="stat-mistake-count">0</div>
          <p class="text-xs text-brand-coral/80 font-medium mt-1">點擊立即前往消滅錯題 →</p>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-purple-100 shadow-xs">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-slate-500">模擬考最高分</span>
            <span class="w-8 h-8 rounded-lg bg-brand-orange/10 text-brand-orange flex items-center justify-center font-bold">🏆</span>
          </div>
          <div class="text-2xl sm:text-3xl font-black text-brand-orange" id="stat-best-score">--</div>
          <p class="text-xs text-slate-400 mt-1">及格標準：<span class="font-bold text-slate-600">70 分</span></p>
        </div>
      </div>

      <!-- 知識點掌握度 & 模擬測驗歷史紀錄 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- 單元知識點掌握度長條圖 -->
        <div class="lg:col-span-7 bg-white rounded-3xl p-6 border border-purple-100 shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div>
                <h3 class="text-lg font-extrabold text-brand-ink">單元知識點掌握度分析</h3>
                <p class="text-xs text-slate-500">依據五大核心命題主軸統計答題正確率</p>
              </div>
              <button onclick="confirmResetStats()" class="text-xs font-bold text-slate-400 hover:text-brand-coral transition px-2.5 py-1 rounded-lg hover:bg-red-50">
                重置統計數據
              </button>
            </div>
            <div id="category-stats-list" class="space-y-4 mt-4">
              <!-- 由 JS 動態生成 -->
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span>💡 建議針對正確率低於 70% 的主題加強刷題</span>
            <span class="font-bold text-brand-electric">共 5 大主題 / 55 題</span>
          </div>
        </div>

        <!-- 模擬測驗歷史成績紀錄 -->
        <div class="lg:col-span-5 bg-white rounded-3xl p-6 border border-purple-100 shadow-xs flex flex-col">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-lg font-extrabold text-brand-ink">模擬測驗成績紀錄</h3>
              <p class="text-xs text-slate-500">最近 10 次模擬考試表現</p>
            </div>
            <span class="px-2.5 py-1 rounded-full bg-brand-berry/10 text-brand-berry text-xs font-bold">70分及格</span>
          </div>
          <div id="exam-history-list" class="flex-1 space-y-2.5 overflow-y-auto max-h-80 pr-1">
            <!-- 由 JS 動態生成 -->
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== 2. 練習模式 (Practice Mode) ==================== -->
    <section id="view-practice" class="hidden space-y-5">
      <!-- 頂部控制列 -->
      <div class="bg-white rounded-2xl p-4 border border-purple-100 shadow-xs flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <button id="btn-mode-seq" onclick="setPracticeOrder('sequential')" class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition">
            順序練習 (1→55)
          </button>
          <button id="btn-mode-rnd" onclick="setPracticeOrder('random')" class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition">
            隨機出題
          </button>
        </div>

        <div class="flex items-center gap-3">
          <span class="text-xs sm:text-sm font-bold text-slate-600">
            進度：<span id="practice-progress-text" class="text-brand-electric font-extrabold">1 / 55</span>
          </span>
          <button onclick="toggleQuestionGrid('practice-grid-drawer')" class="px-3 py-2 rounded-xl bg-purple-50 hover:bg-purple-100 text-brand-electric text-xs sm:text-sm font-bold transition flex items-center gap-1.5">
            <span>🔢 題號總覽</span>
          </button>
        </div>
      </div>

      <!-- 進度條 -->
      <div class="w-full h-2.5 bg-purple-100 rounded-full overflow-hidden">
        <div id="practice-progress-bar" class="h-full bg-gradient-to-r from-brand-magenta via-brand-electric to-brand-orange transition-all duration-300" style="width: 2%"></div>
      </div>

      <!-- 可收合題號跳轉面板 -->
      <div id="practice-grid-drawer" class="hidden bg-white rounded-2xl p-4 border border-purple-100 shadow-sm">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-extrabold text-slate-600">點擊題號快速跳轉（紫框：目前題目｜綠底：已答對｜紅底：曾答錯）</span>
          <button onclick="toggleQuestionGrid('practice-grid-drawer')" class="text-xs text-slate-400 hover:text-slate-600 font-bold">收起 ✕</button>
        </div>
        <div id="practice-number-grid" class="grid grid-cols-7 sm:grid-cols-11 gap-1.5">
          <!-- 由 JS 生成 1-55 題按鈕 -->
        </div>
      </div>

      <!-- 題目主卡片 -->
      <div id="practice-card" class="bg-white rounded-3xl p-5 sm:p-8 border border-purple-100 shadow-sm">
        <!-- 題號、分類與加入錯題本按鈕 -->
        <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
          <div class="flex items-center gap-2">
            <span id="practice-q-badge" class="px-3 py-1 rounded-xl bg-brand-electric text-white text-xs sm:text-sm font-black">第 1 題</span>
            <span id="practice-q-category" class="px-3 py-1 rounded-xl bg-brand-magenta/10 text-brand-electric text-xs font-bold">行銷基本定義</span>
          </div>
          <button id="practice-bookmark-btn" onclick="toggleCurrentBookmark()" class="px-3.5 py-1.5 rounded-xl border text-xs sm:text-sm font-bold flex items-center gap-1.5 transition">
            <span id="practice-bookmark-icon">☆</span>
            <span id="practice-bookmark-text">加入錯題本</span>
          </button>
        </div>

        <!-- 題幹 -->
        <h2 id="practice-q-text" class="text-lg sm:text-xl font-extrabold text-brand-ink leading-relaxed mb-6">
          題目載入中...
        </h2>

        <!-- 四個選項 -->
        <div id="practice-options" class="space-y-3">
          <!-- 由 JS 動態生成選項按鈕 -->
        </div>

        <!-- 即時解析區塊 (答題後顯示) -->
        <div id="practice-explanation-box" class="hidden mt-6 rounded-2xl p-5 bg-gradient-to-br from-orange-50/90 to-purple-50/70 border-l-4 border-brand-orange">
          <div class="flex items-center gap-2 mb-2">
            <span id="practice-result-badge" class="px-2.5 py-0.5 rounded-lg text-xs font-black text-white bg-emerald-600">答對了！</span>
            <span class="text-sm font-extrabold text-brand-ink">正確答案：<span id="practice-correct-ans" class="text-brand-electric text-base">C</span></span>
          </div>
          <div class="text-xs font-bold text-brand-orange uppercase tracking-wider mb-1">💡 觀念解析 Key Takeaway</div>
          <p id="practice-explanation-text" class="text-sm sm:text-base text-slate-700 leading-relaxed"></p>
        </div>

        <!-- 底部導航按鈕 -->
        <div class="mt-8 pt-5 border-t border-slate-100 flex items-center justify-between gap-3">
          <button onclick="prevPracticeQuestion()" class="px-4 sm:px-5 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-sm transition">
            ← 上一題
          </button>
          <span class="hidden sm:inline text-xs text-slate-400 font-medium">快捷鍵：A / B / C / D 選答，Enter 下一題</span>
          <button onclick="nextPracticeQuestion()" class="px-6 sm:px-8 py-3 rounded-xl bg-gradient-to-r from-brand-electric to-brand-magenta text-white font-extrabold text-sm shadow-md shadow-purple-200 hover:opacity-95 active:scale-95 transition">
            下一題 →
          </button>
        </div>
      </div>
    </section>

    <!-- ==================== 3. 模擬測驗模式 (Mock Exam Mode) ==================== -->
    <section id="view-exam" class="hidden space-y-6">
      <!-- 階段 A：測驗設定畫面 -->
      <div id="exam-setup-panel" class="max-w-2xl mx-auto bg-white rounded-3xl p-6 sm:p-8 border border-purple-100 shadow-sm">
        <div class="text-center mb-6">
          <span class="inline-block px-3 py-1 rounded-full bg-brand-berry/15 text-brand-berry text-xs font-extrabold mb-2">SIMULATION EXAM</span>
          <h2 class="text-2xl font-black text-brand-ink">整合行銷管理師｜全真模擬測驗</h2>
          <p class="text-sm text-slate-500 mt-1">作答期間隱藏解析，交卷後統一計分（滿分 100 分，70 分及格）並自動收錄錯題</p>
        </div>

        <div class="space-y-5">
          <!-- 題數選擇 -->
          <div>
            <label class="block text-sm font-extrabold text-brand-ink mb-2">1. 選擇測驗題數</label>
            <div class="grid grid-cols-3 gap-3">
              <button type="button" onclick="selectExamCount(20)" data-exam-count="20" class="exam-count-btn py-3.5 rounded-2xl border-2 font-extrabold text-sm transition">
                20 題<span class="block text-xs font-normal opacity-80">快速小考</span>
              </button>
              <button type="button" onclick="selectExamCount(30)" data-exam-count="30" class="exam-count-btn py-3.5 rounded-2xl border-2 font-extrabold text-sm transition">
                30 題<span class="block text-xs font-normal opacity-80">標準模擬</span>
              </button>
              <button type="button" onclick="selectExamCount(55)" data-exam-count="55" class="exam-count-btn py-3.5 rounded-2xl border-2 font-extrabold text-sm transition">
                55 題<span class="block text-xs font-normal opacity-80">全題庫總決戰</span>
              </button>
            </div>
          </div>

          <!-- 計時器設定 -->
          <div class="flex items-center justify-between p-4 rounded-2xl bg-purple-50/70 border border-purple-100">
            <div>
              <div class="text-sm font-extrabold text-brand-ink">2. 開啟倒數計時器</div>
              <div class="text-xs text-slate-500">預設每題 1 分鐘（例如 20 題限時 20 分鐘），時間到自動交卷</div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="exam-timer-toggle" class="sr-only peer" checked />
              <div class="w-12 h-7 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-brand-electric"></div>
            </label>
          </div>

          <button onclick="startMockExam()" class="w-full py-4 rounded-2xl bg-gradient-to-r from-brand-berry via-brand-magenta to-brand-electric text-white font-black text-base shadow-lg shadow-pink-200 hover:opacity-95 active:scale-[0.99] transition">
            開始模擬測驗 🚀
          </button>
        </div>
      </div>

      <!-- 階段 B：測驗進行中畫面 -->
      <div id="exam-active-panel" class="hidden space-y-5">
        <!-- 頂部狀態與倒數列 -->
        <div class="bg-white rounded-2xl p-4 border border-purple-100 shadow-xs flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="px-3 py-1.5 rounded-xl bg-brand-berry text-white text-xs sm:text-sm font-black">
              第 <span id="exam-curr-num">1</span> / <span id="exam-total-num">20</span> 題
            </span>
