    ];

    // =========================================================================
    // 2. 狀態管理與 LocalStorage 持久化
    // =========================================================================
    const STORAGE_KEY = "imc_cert_quiz_v1";

    let appData = {
      totalAnswered: 0,
      totalCorrect: 0,
      questionStats: {}, // { [qId]: { attempts: 0, correct: 0, lastResult: 'correct'|'wrong' } }
      mistakes: {},      // { [qId]: { count: 1, addedAt: timestamp } }
      examHistory: []    // [{ date, score, correct, total, durationSec }]
    };

    function loadAppData() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          appData = { ...appData, ...parsed };
        }
      } catch (e) {
        console.error("讀取本機紀錄失敗:", e);
      }
      updateMistakeBadges();
    }

    function saveAppData() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(appData));
      } catch (e) {
        console.error("儲存本機紀錄失敗:", e);
      }
      updateMistakeBadges();
    }

    // 記錄單題作答表現
    function recordAnswer(qId, isCorrect) {
      appData.totalAnswered += 1;
      if (isCorrect) {
        appData.totalCorrect += 1;
      }

      if (!appData.questionStats[qId]) {
        appData.questionStats[qId] = { attempts: 0, correct: 0, lastResult: null };
      }
      appData.questionStats[qId].attempts += 1;
      if (isCorrect) {
        appData.questionStats[qId].correct += 1;
        appData.questionStats[qId].lastResult = "correct";
      } else {
        appData.questionStats[qId].lastResult = "wrong";
        addMistake(qId, true);
      }
      saveAppData();
    }

    function addMistake(qId, silent = false) {
      if (!appData.mistakes[qId]) {
        appData.mistakes[qId] = { count: 1, addedAt: Date.now() };
      } else {
        appData.mistakes[qId].count += 1;
      }
      saveAppData();
      if (!silent) showToast(`已將第 ${qId} 題加入錯題本`);
    }

    function removeMistake(qId, silent = false) {
      if (appData.mistakes[qId]) {
        delete appData.mistakes[qId];
        saveAppData();
        if (!silent) showToast(`已將第 ${qId} 題移出錯題本`);
      }
    }

    function updateMistakeBadges() {
      const count = Object.keys(appData.mistakes).length;
      document.getElementById("nav-mistake-badge").textContent = count;
      document.getElementById("mobile-mistake-badge").textContent = count;
      const headerBadge = document.getElementById("mistake-header-count");
      if (headerBadge) headerBadge.textContent = `${count} 題`;
    }

    // =========================================================================
    // 3. UI 通用工具（Toast 提示、Modal 確認框、Tab 切換）
    // =========================================================================
    let currentTab = "dashboard";

    function showToast(message, type = "info") {
      const container = document.getElementById("toast-container");
      const el = document.createElement("div");
      const bgClass = type === "error" ? "bg-brand-coral" : type === "success" ? "bg-emerald-600" : "bg-brand-ink";
      el.className = `${bgClass} text-white px-4 py-2.5 rounded-xl shadow-lg text-xs sm:text-sm font-bold flex items-center gap-2 transition-all duration-300 transform translate-y-2 opacity-0`;
      el.textContent = message;
      container.appendChild(el);

      requestAnimationFrame(() => {
        el.classList.remove("translate-y-2", "opacity-0");
      });

      setTimeout(() => {
        el.classList.add("opacity-0", "translate-y-2");
        setTimeout(() => el.remove(), 300);
      }, 2400);
    }

    function showConfirmModal({ title, desc, confirmText = "確定", onConfirm }) {
      const modal = document.getElementById("confirm-modal");
      document.getElementById("modal-title").textContent = title;
      document.getElementById("modal-desc").textContent = desc;
      const confirmBtn = document.getElementById("modal-confirm-btn");
      const cancelBtn = document.getElementById("modal-cancel-btn");
      confirmBtn.textContent = confirmText;

      modal.classList.remove("hidden");
      modal.classList.add("flex");

      const close = () => {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      };

      cancelBtn.onclick = close;
      confirmBtn.onclick = () => {
        close();
        if (onConfirm) onConfirm();
      };
    }

    function switchTab(tabName) {
      currentTab = tabName;
      const views = ["dashboard", "practice", "exam", "mistakes", "bank"];
      views.forEach(v => {
        const el = document.getElementById(`view-${v}`);
        if (v === tabName) {
          el.classList.remove("hidden");
        } else {
          el.classList.add("hidden");
        }
      });

      // 更新導航按鈕樣式
      document.querySelectorAll(".nav-btn").forEach(btn => {
        if (btn.dataset.tab === tabName) {
          btn.className = "nav-btn whitespace-nowrap px-3.5 py-2 rounded-xl text-sm font-extrabold transition-all bg-brand-electric text-white shadow-sm shadow-purple-200 flex items-center gap-1.5";
        } else {
          btn.className = "nav-btn whitespace-nowrap px-3.5 py-2 rounded-xl text-sm font-bold transition-all text-slate-600 hover:bg-purple-50 hover:text-brand-electric flex items-center gap-1.5";
        }
      });

      // 進入各分頁時刷新視圖
      if (tabName === "dashboard") renderDashboard();
      if (tabName === "practice") renderPracticeQuestion();
      if (tabName === "mistakes") renderMistakesView();
      if (tabName === "bank") renderQuestionBank();
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function toggleQuestionGrid(drawerId) {
      const el = document.getElementById(drawerId);
      el.classList.toggle("hidden");
    }

    // =========================================================================
    // 4. 儀表板與成績統計渲染
    // =========================================================================
    function renderDashboard() {
      document.getElementById("stat-total-answered").textContent = appData.totalAnswered;
      document.getElementById("stat-total-correct").textContent = appData.totalCorrect;
      const uniqueCovered = Object.keys(appData.questionStats).length;
      document.getElementById("stat-unique-covered").textContent = uniqueCovered;

      const accuracy = appData.totalAnswered > 0
        ? Math.round((appData.totalCorrect / appData.totalAnswered) * 100)
        : 0;
      document.getElementById("stat-accuracy").textContent = accuracy;
      document.getElementById("stat-mistake-count").textContent = Object.keys(appData.mistakes).length;

      if (appData.examHistory.length > 0) {
        const best = Math.max(...appData.examHistory.map(h => h.score));
        document.getElementById("stat-best-score").textContent = `${best} 分`;
      } else {
        document.getElementById("stat-best-score").textContent = "尚無紀錄";
      }

      // 渲染五大知識點掌握度
      const catListEl = document.getElementById("category-stats-list");
      catListEl.innerHTML = "";

      CATEGORIES.forEach((cat, idx) => {
        const catQuestions = QUESTIONS.filter(q => q.category === cat);
        let attempts = 0;
        let correct = 0;
        catQuestions.forEach(q => {
          const st = appData.questionStats[q.id];
          if (st) {
            attempts += st.attempts;
            correct += st.correct;
          }
        });
        const rate = attempts > 0 ? Math.round((correct / attempts) * 100) : 0;
        const barColors = [
          "from-brand-electric to-brand-magenta",
          "from-brand-magenta to-brand-berry",
          "from-brand-berry to-brand-coral",
          "from-brand-coral to-brand-orange",
          "from-brand-orange to-brand-electric"
        ];

        const item = document.createElement("div");
        item.className = "space-y-1.5";
        item.innerHTML = `
          <div class="flex items-center justify-between text-xs sm:text-sm">
            <span class="font-bold text-brand-ink truncate pr-2">${idx + 1}. ${cat}</span>
            <span class="font-extrabold shrink-0 ${attempts === 0 ? 'text-slate-400' : rate >= 70 ? 'text-emerald-600' : 'text-brand-coral'}">
              ${attempts === 0 ? '未作答' : `${rate}% (${correct}/${attempts})`}
            </span>
          </div>
          <div class="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden">
            <div class="h-full rounded-full bg-gradient-to-r ${barColors[idx % barColors.length]} transition-all duration-500" style="width: ${rate}%"></div>
          </div>
        `;
        catListEl.appendChild(item);
      });

      // 渲染模擬測驗歷史紀錄
      const histEl = document.getElementById("exam-history-list");
      if (appData.examHistory.length === 0) {
        histEl.innerHTML = `
          <div class="h-48 flex flex-col items-center justify-center text-center p-4 rounded-2xl bg-slate-50 border border-dashed border-slate-200">
            <span class="text-2xl mb-1">📋</span>
            <p class="text-sm font-bold text-slate-500">尚未進行過模擬測驗</p>
            <p class="text-xs text-slate-400 mt-1">點擊上方「進入模擬測驗」檢驗實力吧！</p>
          </div>
        `;
      } else {
        histEl.innerHTML = appData.examHistory.slice(0, 10).map(h => {
          const passed = h.score >= 70;
          const mins = Math.floor(h.durationSec / 60);
          const secs = h.durationSec % 60;
          return `
            <div class="flex items-center justify-between p-3 rounded-2xl border ${passed ? 'border-emerald-100 bg-emerald-50/40' : 'border-red-100 bg-red-50/40'}">
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-base font-black ${passed ? 'text-emerald-600' : 'text-brand-coral'}">${h.score} 分</span>
                  <span class="px-2 py-0.5 rounded-md text-[11px] font-extrabold ${passed ? 'bg-emerald-100 text-emerald-700' : 'bg-brand-coral/15 text-brand-coral'}">
                    ${passed ? '及格' : '未達標'}
                  </span>
                </div>
                <div class="text-[11px] text-slate-400 mt-0.5">${h.date} ｜ 答對 ${h.correct}/${h.total} 題</div>
              </div>
              <div class="text-xs font-mono font-bold text-slate-500">
                ⏱️ ${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}
              </div>
            </div>
          `;
        }).join("");
      }
    }

    function confirmResetStats() {
      showConfirmModal({
        title: "重置所有學習統計？",
        desc: "這將清除您的累計作答次數、各單元正確率與模擬考歷史成績（錯題本可獨立保留或另外清除）。確定要重置嗎？",
        confirmText: "確定重置",
        onConfirm: () => {
          appData.totalAnswered = 0;
          appData.totalCorrect = 0;
          appData.questionStats = {};
          appData.examHistory = [];
          saveAppData();
          renderDashboard();
          showToast("已重置統計數據", "success");
        }
      });
    }

    // =========================================================================
    // 5. 練習模式 (Practice Mode)
    // =========================================================================
    let practiceOrder = "sequential"; // 'sequential' | 'random'
    let practiceQueue = QUESTIONS.map((_, idx) => idx);
    let practiceIndex = 0;
    let practiceSelectedOption = null; // 當前題目已選選項

    function startPracticeMode(order) {
      setPracticeOrder(order);
      switchTab("practice");
    }

    function setPracticeOrder(order) {
      practiceOrder = order;
      if (order === "sequential") {
        practiceQueue = QUESTIONS.map((_, idx) => idx);
      } else {
        practiceQueue = QUESTIONS.map((_, idx) => idx).sort(() => Math.random() - 0.5);
      }
      practiceIndex = 0;
      practiceSelectedOption = null;
      updatePracticeOrderButtons();
      renderPracticeQuestion();
    }

    function updatePracticeOrderButtons() {
      const seqBtn = document.getElementById("btn-mode-seq");
      const rndBtn = document.getElementById("btn-mode-rnd");
      if (practiceOrder === "sequential") {
        seqBtn.className = "px-3.5 py-2 rounded-xl text-xs sm:text-sm font-extrabold bg-brand-electric text-white shadow-xs transition";
        rndBtn.className = "px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition";
      } else {
        rndBtn.className = "px-3.5 py-2 rounded-xl text-xs sm:text-sm font-extrabold bg-brand-magenta text-white shadow-xs transition";
        seqBtn.className = "px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition";
      }
    }

    function renderPracticeQuestion() {
      updatePracticeOrderButtons();
      const qObj = QUESTIONS[practiceQueue[practiceIndex]];

      // 進度文字與進度條
      document.getElementById("practice-progress-text").textContent = `${practiceIndex + 1} / ${QUESTIONS.length}`;
      const pct = ((practiceIndex + 1) / QUESTIONS.length) * 100;
      document.getElementById("practice-progress-bar").style.width = `${pct}%`;

      // 題號與分類
      document.getElementById("practice-q-badge").textContent = `第 ${qObj.id} 題`;
      document.getElementById("practice-q-category").textContent = qObj.category;
      document.getElementById("practice-q-text").textContent = qObj.question;

      // 更新書籤（錯題本）按鈕狀態
      updatePracticeBookmarkUI(qObj.id);

      // 渲染選項
      const optsContainer = document.getElementById("practice-options");
      optsContainer.innerHTML = "";
      ["A", "B", "C", "D"].forEach(key => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.onclick = () => handlePracticeSelect(key);

        let baseStyle = "w-full text-left p-4 rounded-2xl border-2 transition-all flex items-start gap-3.5 group ";
        let badgeStyle = "w-8 h-8 rounded-xl flex items-center justify-center font-black text-sm shrink-0 transition-colors ";

        if (!practiceSelectedOption) {
          baseStyle += "border-slate-200 hover:border-brand-electric hover:bg-purple-50/50 cursor-pointer";
          badgeStyle += "bg-slate-100 text-slate-600 group-hover:bg-brand-electric group-hover:text-white";
        } else {
          // 已作答狀態
          if (key === qObj.answer) {
            baseStyle += "border-emerald-500 bg-emerald-50/80 text-emerald-950";
            badgeStyle += "bg-emerald-500 text-white";
          } else if (key === practiceSelectedOption && key !== qObj.answer) {
            baseStyle += "border-brand-coral bg-red-50/80 text-red-950";
            badgeStyle += "bg-brand-coral text-white";
          } else {
            baseStyle += "border-slate-100 bg-slate-50/50 text-slate-400 opacity-75";
            badgeStyle += "bg-slate-100 text-slate-400";
          }
        }

        btn.className = baseStyle;
        btn.innerHTML = `
          <span class="${badgeStyle}">${key}</span>
          <span class="text-sm sm:text-base font-medium leading-relaxed pt-0.5">${qObj.options[key]}</span>
        `;
        optsContainer.appendChild(btn);
      });

      // 解析框顯示控制
      const expBox = document.getElementById("practice-explanation-box");
      if (practiceSelectedOption) {
        const isCorrect = practiceSelectedOption === qObj.answer;
        const resBadge = document.getElementById("practice-result-badge");
        resBadge.textContent = isCorrect ? "✓ 答對了！" : "✕ 答錯了（已自動收錄至錯題本）";
        resBadge.className = `px-2.5 py-0.5 rounded-lg text-xs font-black text-white ${isCorrect ? "bg-emerald-600" : "bg-brand-coral"}`;
        document.getElementById("practice-correct-ans").textContent = qObj.answer;
        document.getElementById("practice-explanation-text").textContent = qObj.explanation;
        expBox.classList.remove("hidden");
      } else {
        expBox.classList.add("hidden");
      }

      renderPracticeGrid();
    }

    function handlePracticeSelect(optionKey) {
      if (practiceSelectedOption) return; // 防止重複計分
      practiceSelectedOption = optionKey;
      const qObj = QUESTIONS[practiceQueue[practiceIndex]];
      const isCorrect = optionKey === qObj.answer;
      recordAnswer(qObj.id, isCorrect);
      renderPracticeQuestion();
    }

    function nextPracticeQuestion() {
      if (practiceIndex < QUESTIONS.length - 1) {
        practiceIndex += 1;
        practiceSelectedOption = null;
        renderPracticeQuestion();
      } else {
        showToast("已經是最後一題囉！", "success");
      }
    }

    function prevPracticeQuestion() {
      if (practiceIndex > 0) {
        practiceIndex -= 1;
        practiceSelectedOption = null;
        renderPracticeQuestion();
      } else {
        showToast("已經是第一題囉！");
      }
    }

    function toggleCurrentBookmark() {
      const qObj = QUESTIONS[practiceQueue[practiceIndex]];
      if (appData.mistakes[qObj.id]) {
        removeMistake(qObj.id);
      } else {
        addMistake(qObj.id);
      }
      updatePracticeBookmarkUI(qObj.id);
    }

    function updatePracticeBookmarkUI(qId) {
      const btn = document.getElementById("practice-bookmark-btn");
      const icon = document.getElementById("practice-bookmark-icon");
      const text = document.getElementById("practice-bookmark-text");
      const isBookmarked = Boolean(appData.mistakes[qId]);

      if (isBookmarked) {
        btn.className = "px-3.5 py-1.5 rounded-xl border border-brand-coral bg-brand-coral/10 text-brand-coral text-xs sm:text-sm font-bold flex items-center gap-1.5 transition";
        icon.textContent = "★";
        text.textContent = "已在錯題本中";
      } else {
        btn.className = "px-3.5 py-1.5 rounded-xl border border-slate-200 hover:border-brand-coral text-slate-600 hover:text-brand-coral text-xs sm:text-sm font-bold flex items-center gap-1.5 transition";
        icon.textContent = "☆";
        text.textContent = "加入錯題本";
      }
    }

    function renderPracticeGrid() {
      const grid = document.getElementById("practice-number-grid");
      grid.innerHTML = "";
      practiceQueue.forEach((qIdx, queuePos) => {
        const q = QUESTIONS[qIdx];
        const st = appData.questionStats[q.id];
        const isCurrent = queuePos === practiceIndex;

        let cls = "py-1.5 rounded-lg text-xs font-bold border transition ";
        if (isCurrent) {
          cls += "border-2 border-brand-electric ring-2 ring-brand-electric/30 ";
        } else {
          cls += "border-slate-200 ";
        }

        if (st?.lastResult === "correct") {
          cls += "bg-emerald-100 text-emerald-800";
        } else if (st?.lastResult === "wrong") {
          cls += "bg-red-100 text-brand-coral";
        } else {
          cls += "bg-white text-slate-600 hover:bg-purple-50";
        }

        const btn = document.createElement("button");
        btn.className = cls;
        btn.textContent = q.id;
        btn.onclick = () => {
          practiceIndex = queuePos;
          practiceSelectedOption = null;
          renderPracticeQuestion();
        };
        grid.appendChild(btn);
      });
    }

    // =========================================================================
    // 6. 模擬測驗模式 (Mock Exam Mode)
    // =========================================================================
    let examConfigCount = 20;
    let examState = {
      questions: [],
      userAnswers: {}, // { [idx]: 'A'|'B'|'C'|'D' }
      flagged: {},     // { [idx]: true }
      currentIndex: 0,
      timerEnabled: true,
      remainingSec: 1200,
      totalSec: 1200,
      timerInterval: null
    };

    function selectExamCount(count) {
      examConfigCount = count;
      document.querySelectorAll(".exam-count-btn").forEach(btn => {
        if (Number(btn.dataset.examCount) === count) {
          btn.className = "exam-count-btn py-3.5 rounded-2xl border-2 border-brand-electric bg-brand-electric/10 text-brand-electric font-extrabold text-sm transition";
        } else {
          btn.className = "exam-count-btn py-3.5 rounded-2xl border-2 border-slate-200 text-slate-600 hover:border-purple-200 font-bold text-sm transition";
        }
      });
    }

    function startMockExam() {
      const shuffled = [...QUESTIONS].sort(() => Math.random() - 0.5).slice(0, examConfigCount);
      const timerEnabled = document.getElementById("exam-timer-toggle").checked;
      const totalSec = examConfigCount * 60;

      examState = {
        questions: shuffled,
        userAnswers: {},
        flagged: {},
        currentIndex: 0,
        timerEnabled,
        remainingSec: totalSec,
        totalSec,
        timerInterval: null
      };

      document.getElementById("exam-setup-panel").classList.add("hidden");
      document.getElementById("exam-result-panel").classList.add("hidden");
      document.getElementById("exam-active-panel").classList.remove("hidden");

      document.getElementById("exam-total-num").textContent = examConfigCount;
      document.getElementById("exam-total-num-2").textContent = examConfigCount;

      const timerBox = document.getElementById("exam-timer-box");
      if (timerEnabled) {
        timerBox.classList.remove("hidden");
        updateExamTimerDisplay();
        examState.timerInterval = setInterval(() => {
          examState.remainingSec -= 1;
          updateExamTimerDisplay();
          if (examState.remainingSec <= 0) {
            clearInterval(examState.timerInterval);
            showToast("測驗時間到，系統已自動交卷！", "error");
            submitMockExam();
          }
        }, 1000);
      } else {
        timerBox.classList.add("hidden");
      }

      renderExamQuestion();
    }

    function updateExamTimerDisplay() {
      const mins = Math.floor(Math.max(0, examState.remainingSec) / 60);
      const secs = Math.max(0, examState.remainingSec) % 60;
      document.getElementById("exam-timer-display").textContent =
        `${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;
    }

    function renderExamQuestion() {
      const idx = examState.currentIndex;
      const qObj = examState.questions[idx];
      const chosen = examState.userAnswers[idx];

      document.getElementById("exam-curr-num").textContent = idx + 1;
      document.getElementById("exam-q-orig-id").textContent = `題庫原題號 #${qObj.id} ｜ ${qObj.category}`;
      document.getElementById("exam-q-text").textContent = qObj.question;

      const answeredCount = Object.keys(examState.userAnswers).length;
      document.getElementById("exam-answered-count").textContent = answeredCount;

      // 標記按鈕狀態
      const flagBtn = document.getElementById("exam-flag-btn");
      if (examState.flagged[idx]) {
        flagBtn.className = "px-3 py-1.5 rounded-xl border border-brand-orange bg-brand-orange/15 text-brand-orange text-xs font-extrabold transition";
        flagBtn.textContent = "🚩 已標記不確定";
      } else {
        flagBtn.className = "px-3 py-1.5 rounded-xl border border-slate-200 text-slate-500 hover:border-brand-orange hover:text-brand-orange text-xs font-bold transition";
        flagBtn.textContent = "🏳️ 標記不確定";
      }

      // 渲染四個選項
      const optsEl = document.getElementById("exam-options");
      optsEl.innerHTML = "";
      ["A", "B", "C", "D"].forEach(key => {
        const isSelected = chosen === key;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.onclick = () => {
          examState.userAnswers[idx] = key;
          renderExamQuestion();
        };
        btn.className = `w-full text-left p-4 rounded-2xl border-2 transition-all flex items-start gap-3.5 ${
          isSelected
            ? "border-brand-electric bg-brand-electric/10 text-brand-ink shadow-xs"
            : "border-slate-200 hover:border-purple-300 bg-white text-slate-700"
        }`;
        btn.innerHTML = `
          <span class="w-8 h-8 rounded-xl flex items-center justify-center font-black text-sm shrink-0 ${
            isSelected ? "bg-brand-electric text-white" : "bg-slate-100 text-slate-600"
          }">${key}</span>
          <span class="text-sm sm:text-base font-medium leading-relaxed pt-0.5">${qObj.options[key]}</span>
        `;
        optsEl.appendChild(btn);
      });

      // 最後一題按鈕提示
      const nextBtn = document.getElementById("exam-next-btn");
      if (idx === examState.questions.length - 1) {
        nextBtn.textContent = "完成並交卷 ✓";
        nextBtn.className = "px-6 py-3 rounded-xl bg-brand-orange text-white font-extrabold text-sm shadow-md transition";
      } else {
        nextBtn.textContent = "下一題 →";
        nextBtn.className = "px-6 py-3 rounded-xl bg-brand-electric text-white font-extrabold text-sm shadow-md transition";
      }

      renderExamGrid();
    }

    function renderExamGrid() {
      const grid = document.getElementById("exam-number-grid");
      grid.innerHTML = "";
      examState.questions.forEach((_, idx) => {
        const isCurr = idx === examState.currentIndex;
        const isAns = Boolean(examState.userAnswers[idx]);
        const isFlag = Boolean(examState.flagged[idx]);

        let cls = "py-1.5 rounded-lg text-xs font-extrabold border transition ";
        if (isCurr) cls += "ring-2 ring-brand-magenta ";
        if (isFlag) cls += "border-2 border-brand-orange ";
        else cls += "border-slate-200 ";

        if (isAns) cls += "bg-brand-electric text-white";
        else cls += "bg-white text-slate-600 hover:bg-purple-50";

        const btn = document.createElement("button");
        btn.className = cls;
        btn.textContent = idx + 1;
        btn.onclick = () => {
          examState.currentIndex = idx;
          renderExamQuestion();
        };
        grid.appendChild(btn);
      });
    }

    function toggleExamFlag() {
      const idx = examState.currentIndex;
      if (examState.flagged[idx]) {
        delete examState.flagged[idx];
      } else {
        examState.flagged[idx] = true;
      }
      renderExamQuestion();
    }

    function prevExamQuestion() {
      if (examState.currentIndex > 0) {
        examState.currentIndex -= 1;
        renderExamQuestion();
      }
    }

    function nextExamQuestion() {
      if (examState.currentIndex < examState.questions.length - 1) {
        examState.currentIndex += 1;
        renderExamQuestion();
      } else {
        confirmSubmitExam();
      }
    }

    function confirmSubmitExam() {
      const total = examState.questions.length;
      const answered = Object.keys(examState.userAnswers).length;
      const unanswered = total - answered;
      const msg = unanswered > 0
        ? `您還有 ${unanswered} 題尚未作答！確定現在就要交卷計分嗎？`
        : "您已完成全部題目，確定要交卷並查看成績與解析嗎？";

      showConfirmModal({
        title: "確認交卷？",
        desc: msg,
        confirmText: "立即交卷",
        onConfirm: submitMockExam
      });
    }

    function submitMockExam() {
      if (examState.timerInterval) {
        clearInterval(examState.timerInterval);
      }

      const total = examState.questions.length;
      let correctCount = 0;

      examState.questions.forEach((qObj, idx) => {
        const userAns = examState.userAnswers[idx];
        const isCorrect = userAns === qObj.answer;
        if (isCorrect) correctCount += 1;
        recordAnswer(qObj.id, isCorrect);
      });

      const score = Math.round((correctCount / total) * 100);
      const durationSec = examState.timerEnabled
        ? (examState.totalSec - Math.max(0, examState.remainingSec))
        : 0;

      // 儲存模擬考歷史紀錄
      const now = new Date();
      const dateStr = `${now.getFullYear()}/${String(now.getMonth() + 1).padStart(2, '0')}/${String(now.getDate()).padStart(2, '0')} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
      appData.examHistory.unshift({
        date: dateStr,
        score,
        correct: correctCount,
        total,
        durationSec
      });
      saveAppData();

      // 切換至成績檢討畫面
      document.getElementById("exam-active-panel").classList.add("hidden");
      document.getElementById("exam-result-panel").classList.remove("hidden");

      const passed = score >= 70;
      const passBadge = document.getElementById("exam-pass-badge");
      passBadge.textContent = passed ? "🎉 恭喜通過 70 分及格標準！" : "💪 差一點點，再複習一下錯題吧！";
      passBadge.className = `inline-block px-4 py-1.5 rounded-full text-sm font-black mb-3 ${
        passed ? "bg-emerald-100 text-emerald-700" : "bg-brand-coral/15 text-brand-coral"
      }`;

      document.getElementById("exam-final-score").textContent = score;
      document.getElementById("exam-correct-total").textContent = correctCount;
      document.getElementById("exam-question-total").textContent = total;
      const mins = Math.floor(durationSec / 60);
      const secs = durationSec % 60;
      document.getElementById("exam-time-used").textContent = examState.timerEnabled
        ? `${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}`
        : "不限時";

      renderExamReviewList("all");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function renderExamReviewList(filter) {
      const btnAll = document.getElementById("review-filter-all");
      const btnWrong = document.getElementById("review-filter-wrong");
      if (filter === "all") {
        btnAll.className = "px-3.5 py-1.5 rounded-xl text-xs font-bold bg-brand-electric text-white";
        btnWrong.className = "px-3.5 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-600";
      } else {
        btnWrong.className = "px-3.5 py-1.5 rounded-xl text-xs font-bold bg-brand-coral text-white";
        btnAll.className = "px-3.5 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-600";
      }

      const container = document.getElementById("exam-review-list");
      container.innerHTML = "";

      const items = examState.questions
        .map((qObj, idx) => ({ qObj, idx, userAns: examState.userAnswers[idx] }))
        .filter(item => filter === "all" || item.userAns !== item.qObj.answer);

      if (items.length === 0) {
        container.innerHTML = `<div class="bg-white rounded-2xl p-8 text-center text-sm font-bold text-emerald-600 border border-emerald-100">太神啦！本次測驗完全沒有錯題！</div>`;
        return;
      }

      items.forEach(({ qObj, idx, userAns }) => {
        const isCorrect = userAns === qObj.answer;
        const card = document.createElement("div");
        card.className = `bg-white rounded-2xl p-5 sm:p-6 border-2 ${isCorrect ? "border-emerald-100" : "border-brand-coral/30"}`;
        card.innerHTML = `
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-lg text-xs font-black text-white ${isCorrect ? "bg-emerald-600" : "bg-brand-coral"}">
                ${isCorrect ? "✓ 答對" : "✕ 答錯"}
              </span>
              <span class="text-xs font-bold text-slate-500">測驗第 ${idx + 1} 題（題庫 #${qObj.id}）</span>
            </div>
            <span class="text-xs font-extrabold text-brand-electric">
              您的作答：${userAns || "未作答"} ｜ 正確答案：${qObj.answer}
            </span>
          </div>
          <h4 class="text-base font-extrabold text-brand-ink mb-3">${qObj.question}</h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-4 text-xs sm:text-sm">
            ${["A", "B", "C", "D"].map(k => {
              let optCls = "p-2.5 rounded-xl border ";
              if (k === qObj.answer) optCls += "border-emerald-400 bg-emerald-50 font-bold text-emerald-900";
              else if (k === userAns) optCls += "border-brand-coral bg-red-50 font-bold text-red-900";
              else optCls += "border-slate-100 text-slate-600";
              return `<div class="${optCls}">(${k}) ${qObj.options[k]}</div>`;
            }).join("")}
          </div>
          <div class="p-3.5 rounded-xl bg-orange-50/70 border-l-4 border-brand-orange text-xs sm:text-sm text-slate-700 leading-relaxed">
            <strong class="text-brand-orange">解析：</strong>${qObj.explanation}
          </div>
        `;
        container.appendChild(card);
      });
    }

    function resetExamToSetup() {
      document.getElementById("exam-result-panel").classList.add("hidden");
      document.getElementById("exam-active-panel").classList.add("hidden");
      document.getElementById("exam-setup-panel").classList.remove("hidden");
    }

    // =========================================================================
    // 7. 錯題練習模式 (Mistake Review Mode)
    // =========================================================================
    let drillList = [];
    let drillIndex = 0;
    let drillChosen = null;

    function renderMistakesView() {
      const mistakeIds = Object.keys(appData.mistakes).map(Number).sort((a, b) => a - b);
      updateMistakeBadges();

      const container = document.getElementById("mistake-list-container");
      const startBtn = document.getElementById("btn-start-mistake-drill");

      if (mistakeIds.length === 0) {
        startBtn.disabled = true;
        startBtn.classList.add("opacity-50", "cursor-not-allowed");
        document.getElementById("mistake-drill-box").classList.add("hidden");
        container.innerHTML = `
          <div class="bg-white rounded-3xl p-10 text-center border border-purple-100">
            <div class="text-4xl mb-3">🌟</div>
            <h3 class="text-lg font-extrabold text-brand-ink">目前錯題本空空如也！</h3>
            <p class="text-sm text-slate-500 mt-1 mb-5">在練習或模擬測驗中答錯的題目會自動出現在這裡，也可以在練習時手動點擊星號加入。</p>
            <button onclick="switchTab('practice')" class="px-5 py-2.5 rounded-xl bg-brand-electric text-white font-bold text-sm">
              前往刷題練習 →
            </button>
          </div>
        `;
        return;
      }

      startBtn.disabled = false;
      startBtn.classList.remove("opacity-50", "cursor-not-allowed");

      container.innerHTML = mistakeIds.map(qId => {
        const qObj = QUESTIONS.find(q => q.id === qId);
        const info = appData.mistakes[qId];
        return `
          <div class="bg-white rounded-2xl p-5 sm:p-6 border border-purple-100 shadow-xs">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded-lg bg-brand-electric text-white text-xs font-black">第 ${qObj.id} 題</span>
                <span class="px-2.5 py-1 rounded-lg bg-brand-coral/10 text-brand-coral text-xs font-extrabold">累計答錯 ${info.count} 次</span>
                <span class="hidden sm:inline text-xs text-slate-400 font-medium">${qObj.category}</span>
              </div>
              <button onclick="handleRemoveMistakeFromList(${qObj.id})" class="px-3 py-1 rounded-lg bg-slate-100 hover:bg-emerald-50 text-slate-600 hover:text-emerald-700 text-xs font-bold transition">
                ✓ 移出錯題本
              </button>
            </div>
            <h3 class="text-base font-extrabold text-brand-ink mb-3">${qObj.question}</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs sm:text-sm mb-3">
              ${["A", "B", "C", "D"].map(k => `
                <div class="p-2.5 rounded-xl border ${k === qObj.answer ? 'border-emerald-400 bg-emerald-50 font-bold text-emerald-900' : 'border-slate-100 text-slate-600'}">
                  (${k}) ${qObj.options[k]}
                </div>
              `).join("")}
            </div>
            <div class="p-3.5 rounded-xl bg-orange-50/70 border-l-4 border-brand-orange text-xs sm:text-sm text-slate-700 leading-relaxed">
              <strong class="text-brand-orange">正解 (${qObj.answer}) 解析：</strong>${qObj.explanation}
            </div>
          </div>
        `;
      }).join("");
    }

    function handleRemoveMistakeFromList(qId) {
      removeMistake(qId);
      renderMistakesView();
    }

    function confirmClearMistakes() {
      const count = Object.keys(appData.mistakes).length;
      if (count === 0) {
        showToast("目前沒有錯題可清空");
        return;
      }
      showConfirmModal({
        title: "清空全部錯題？",
        desc: `確定要移除錯題本中的全部 ${count} 道題目嗎？此操作無法復原。`,
        confirmText: "確定清空",
        onConfirm: () => {
          appData.mistakes = {};
          saveAppData();
          renderMistakesView();
          showToast("已清空錯題本", "success");
        }
      });
    }

    function startMistakeDrill() {
      const mistakeIds = Object.keys(appData.mistakes).map(Number).sort((a, b) => a - b);
      if (mistakeIds.length === 0) return;

      drillList = mistakeIds;
      drillIndex = 0;
      drillChosen = null;

      document.getElementById("mistake-drill-box").classList.remove("hidden");
      renderDrillQuestion();
      document.getElementById("mistake-drill-box").scrollIntoView({ behavior: "smooth" });
    }

    function closeMistakeDrill() {
      document.getElementById("mistake-drill-box").classList.add("hidden");
    }

    function renderDrillQuestion() {
      if (drillList.length === 0) {
        closeMistakeDrill();
        renderMistakesView();
        return;
      }
      if (drillIndex >= drillList.length) drillIndex = drillList.length - 1;

      const qId = drillList[drillIndex];
      const qObj = QUESTIONS.find(q => q.id === qId);
      const count = appData.mistakes[qId]?.count || 1;

      document.getElementById("drill-progress").textContent = `${drillIndex + 1} / ${drillList.length}`;
      document.getElementById("drill-q-id").textContent = `題庫第 ${qObj.id} 題`;
      document.getElementById("drill-wrong-times").textContent = `累計答錯 ${count} 次`;
      document.getElementById("drill-q-text").textContent = qObj.question;

      const optsEl = document.getElementById("drill-options");
      optsEl.innerHTML = "";
      ["A", "B", "C", "D"].forEach(key => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.onclick = () => {
          if (drillChosen) return;
          drillChosen = key;
          const isCorrect = key === qObj.answer;
          recordAnswer(qObj.id, isCorrect);
          renderDrillQuestion();
          renderMistakesView();
        };

        let cls = "w-full text-left p-3.5 rounded-2xl border-2 transition flex items-start gap-3 ";
        if (!drillChosen) {
          cls += "border-slate-200 hover:border-brand-coral hover:bg-red-50/40";
        } else if (key === qObj.answer) {
          cls += "border-emerald-500 bg-emerald-50 font-bold text-emerald-950";
        } else if (key === drillChosen) {
          cls += "border-brand-coral bg-red-50 text-red-950";
        } else {
          cls += "border-slate-100 opacity-60";
        }

        btn.className = cls;
        btn.innerHTML = `
          <span class="w-7 h-7 rounded-lg bg-slate-100 flex items-center justify-center font-black text-xs shrink-0">${key}</span>
          <span class="text-sm font-medium pt-0.5">${qObj.options[key]}</span>
        `;
        optsEl.appendChild(btn);
      });

      const fb = document.getElementById("drill-feedback");
      if (drillChosen) {
        const isCorrect = drillChosen === qObj.answer;
        const lbl = document.getElementById("drill-result-label");
        lbl.textContent = isCorrect ? "🎉 太棒了，這次答對了！" : `✕ 還是答錯囉，正解是 (${qObj.answer})`;
        lbl.className = `text-sm font-black ${isCorrect ? "text-emerald-600" : "text-brand-coral"}`;
        document.getElementById("drill-explanation").textContent = qObj.explanation;
        fb.classList.remove("hidden");
      } else {
        fb.classList.add("hidden");
      }
    }

    function removeCurrentDrillFromMistakes() {
      const qId = drillList[drillIndex];
      removeMistake(qId);
      drillList.splice(drillIndex, 1);
      drillChosen = null;
      renderMistakesView();
      renderDrillQuestion();
    }

    function nextDrillQuestion() {
      if (drillIndex < drillList.length - 1) {
        drillIndex += 1;
        drillChosen = null;
        renderDrillQuestion();
      } else {
        showToast("已練習完最後一題錯題！", "success");
      }
    }

    function prevDrillQuestion() {
      if (drillIndex > 0) {
        drillIndex -= 1;
        drillChosen = null;
        renderDrillQuestion();
      }
    }

    // =========================================================================
    // 8. 全題庫瀏覽與搜尋 (All Questions Bank)
    // =========================================================================
    let showBankAnswers = true;

    function toggleBankAnswers() {
      showBankAnswers = !showBankAnswers;
      const btn = document.getElementById("toggle-bank-answers-btn");
      btn.textContent = showBankAnswers ? "👁️ 隱藏答案與解析" : "👁️‍🗨️ 顯示答案與解析";
      renderQuestionBank();
    }

    function renderQuestionBank() {
      const keyword = document.getElementById("bank-search-input").value.trim().toLowerCase();
      const catFilter = document.getElementById("bank-category-filter").value;

      const filtered = QUESTIONS.filter(q => {
        const matchCat = catFilter === "all" || q.category === catFilter;
        const fullText = `${q.id} ${q.question} ${q.options.A} ${q.options.B} ${q.options.C} ${q.options.D} ${q.explanation}`.toLowerCase();
        const matchKey = !keyword || fullText.includes(keyword);
        return matchCat && matchKey;
      });

      document.getElementById("bank-result-count").textContent = filtered.length;
      const container = document.getElementById("bank-list-container");

      if (filtered.length === 0) {
        container.innerHTML = `<div class="bg-white rounded-2xl p-8 text-center text-sm font-bold text-slate-400 border border-purple-100">找不到符合「${keyword}」的題目，請嘗試其他關鍵字。</div>`;
        return;
      }

      container.innerHTML = filtered.map(q => {
        const isMistake = Boolean(appData.mistakes[q.id]);
        return `
          <div class="bg-white rounded-2xl p-5 sm:p-6 border border-purple-100 shadow-xs">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded-lg bg-brand-electric text-white text-xs font-black">第 ${q.id} 題</span>
                <span class="px-2.5 py-1 rounded-lg bg-purple-50 text-brand-electric text-xs font-bold">${q.category}</span>
              </div>
              <button onclick="toggleBankBookmark(${q.id})" class="text-xs font-bold px-2.5 py-1 rounded-lg border transition ${isMistake ? 'border-brand-coral bg-brand-coral/10 text-brand-coral' : 'border-slate-200 text-slate-500 hover:border-brand-coral'}">
                ${isMistake ? '★ 已在錯題本' : '☆ 加入錯題本'}
              </button>
            </div>
            <h3 class="text-base sm:text-lg font-extrabold text-brand-ink mb-3">${q.question}</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs sm:text-sm ${showBankAnswers ? 'mb-4' : ''}">
              ${["A", "B", "C", "D"].map(k => {
                const highlight = showBankAnswers && k === q.answer;
                return `
                  <div class="p-3 rounded-xl border ${highlight ? 'border-emerald-500 bg-emerald-50/90 font-bold text-emerald-950' : 'border-slate-100 bg-slate-50/50 text-slate-700'}">
                    <span class="font-black mr-1.5 ${highlight ? 'text-emerald-600' : 'text-slate-400'}">(${k})</span>${q.options[k]}
                  </div>
                `;
              }).join("")}
            </div>
            ${showBankAnswers ? `
              <div class="p-4 rounded-xl bg-orange-50/70 border-l-4 border-brand-orange text-xs sm:text-sm text-slate-700 leading-relaxed">
                <span class="font-black text-brand-orange mr-1">標準答案：(${q.answer})</span>
                <p class="mt-1">${q.explanation}</p>
              </div>
            ` : ''}
          </div>
        `;
      }).join("");
    }

    function toggleBankBookmark(qId) {
      if (appData.mistakes[qId]) {
        removeMistake(qId);
      } else {
        addMistake(qId);
      }
      renderQuestionBank();
    }

    // =========================================================================
    // 9. 鍵盤快捷鍵支援 (電腦版刷題更流暢)
    // =========================================================================
    document.addEventListener("keydown", (e) => {
      // 若正在輸入搜尋框則不觸發快捷鍵
      if (document.activeElement.tagName === "INPUT" || document.activeElement.tagName === "SELECT") {
        return;
      }

      const key = e.key.toUpperCase();
      const keyMap = { "1": "A", "2": "B", "3": "C", "4": "D", "A": "A", "B": "B", "C": "C", "D": "D" };

      if (currentTab === "practice") {
        if (keyMap[key]) {
          handlePracticeSelect(keyMap[key]);
        } else if (e.key === "Enter" || e.key === "ArrowRight") {
          nextPracticeQuestion();
        } else if (e.key === "ArrowLeft") {
          prevPracticeQuestion();
        }
      } else if (currentTab === "exam" && !document.getElementById("exam-active-panel").classList.contains("hidden")) {
        if (keyMap[key]) {
          examState.userAnswers[examState.currentIndex] = keyMap[key];
          renderExamQuestion();
        } else if (e.key === "ArrowRight") {
          nextExamQuestion();
        } else if (e.key === "ArrowLeft") {
          prevExamQuestion();
        }
      }
    });

    // =========================================================================
    // 10. 初始化應用程式
    // =========================================================================
    window.addEventListener("DOMContentLoaded", () => {
      loadAppData();
      selectExamCount(20);
      switchTab("dashboard");
    });
  </script>
</body>
</html>
